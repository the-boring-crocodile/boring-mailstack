# Fixed values the stack's own components share. Not configuration: change
# them only together with the code (compose.yaml gives this file to the
# services that need it; tools/deploy's junk port check reads
# MAILSTACK_JUNK_PORT inside mail-bridge).
#
# Stalwart's second SMTP port, internal only: mail from the provider's Junk.
MAILSTACK_JUNK_PORT=2525
# Largest mail the stack takes (bridge, Stalwart, relay): 256 MiB.
MAILSTACK_MAX_MESSAGE_BYTES=268435456
# Where the bridge listens for getmail's handovers (mail-bridge:<port>).
MAILSTACK_BRIDGE_PORT=8025
