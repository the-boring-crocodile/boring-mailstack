digraph "Who is trusted" {
graph [fontname="Helvetica", bgcolor="#ffffff", pad=0.444, splines=line, outputorder=nodesfirst];
node [fontname="Helvetica", fontsize=10, fontcolor="#111111"];
edge [arrowsize=0.9, penwidth=1.4];
title [pos="288.0,612.5", shape=plaintext, width=7.777777777777778, height=0.5416666666666666, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="560"><FONT POINT-SIZE="12"><B><FONT POINT-SIZE="18">Who is trusted</FONT></B></FONT></TD></TR><TR><TD HEIGHT="3"></TD></TR><TR><TD ALIGN="LEFT" WIDTH="560">Trust boundaries · boring-mailstack · a small office: one machine, a handful of people</TD></TR></TABLE>>];
lan [pos="360.0,340.0", shape=box, style="filled,rounded", fillcolor="#f7f9fb", color="#9aaabb", penwidth=1.2, width=9.444444444444445, height=6.111111111111111, fixedsize=true, label=""];
users [pos="360.0,310.0", shape=box, style="filled,rounded", fillcolor="#eef3f8", color="#8fa1b4", penwidth=1.2, width=8.61111111111111, height=4.444444444444445, fixedsize=true, label=""];
root [pos="255.0,265.0", shape=box, style="filled,rounded", fillcolor="#e2eaf4", color="#7489a5", penwidth=1.6, width=4.861111111111111, height=2.361111111111111, fixedsize=true, label=""];
t_lan [pos="336.0,520.0", shape=plaintext, width=8.333333333333334, height=0.7222222222222222, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="600"><FONT POINT-SIZE="12"><B>The LAN · trusted by default</B></FONT></TD></TR><TR><TD HEIGHT="3"></TD></TR><TR><TD ALIGN="LEFT" WIDTH="600">Webmail and the admin page are plain HTTP on the machine's LAN address,</TD></TR><TR><TD ALIGN="LEFT" WIDTH="600">so every computer in the house or office can open them.</TD></TR></TABLE>>];
t_users [pos="356.0,430.0", shape=plaintext, width=8.055555555555555, height=0.7222222222222222, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="580"><FONT POINT-SIZE="12"><B>Everyone with an account · trusted not to attack the office</B></FONT></TD></TR><TR><TD HEIGHT="3"></TD></TR><TR><TD ALIGN="LEFT" WIDTH="580">Each one's logins (mail, Nextcloud) are theirs alone.</TD></TR><TR><TD ALIGN="LEFT" WIDTH="580">The webmail connects to the contact and Nextcloud addresses they type in.</TD></TR></TABLE>>];
t_root [pos="256.0,277.5", shape=plaintext, width=4.444444444444445, height=1.625, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="320"><FONT POINT-SIZE="12"><B>You (root) and the stack · fully trusted</B></FONT></TD></TR><TR><TD HEIGHT="3"></TD></TR><TR><TD ALIGN="LEFT" WIDTH="320">You hold every provider password (accounts.yaml)</TD></TR><TR><TD ALIGN="LEFT" WIDTH="320">and can read every mailbox, as the administrator</TD></TR><TR><TD ALIGN="LEFT" WIDTH="320">of any mail server can. Tell your users so.</TD></TR><TR><TD ALIGN="LEFT" WIDTH="320"> </TD></TR><TR><TD ALIGN="LEFT" WIDTH="320">Inside the stack, TLS to the mail server is not</TD></TR><TR><TD ALIGN="LEFT" WIDTH="320">verified: whoever gets in here can read the</TD></TR><TR><TD ALIGN="LEFT" WIDTH="320">secrets anyway.</TD></TR></TABLE>>];
t_guard [pos="555.0,296.0", shape=plaintext, width=2.9722222222222223, height=0.7222222222222222, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="214">Roundcube shares a network with the mail</TD></TR><TR><TD ALIGN="LEFT" WIDTH="214">server only: addresses users type in reach</TD></TR><TR><TD ALIGN="LEFT" WIDTH="214">the LAN and the Internet, never the</TD></TR><TR><TD ALIGN="LEFT" WIDTH="214">stack's own services.</TD></TR></TABLE>>];
g_a [pos="650,248", shape=point, width=0.01, style=invis];
g_b [pos="430,248", shape=point, width=0.01, style=invis];
g_a -> g_b [arrowhead=tee, color="#8c8d87"];
o_host [pos="910.0,498.0", shape=box, style=filled, fillcolor="#f5f5f3", color="#8c8d87", penwidth=1.2, width=3.3333333333333335, height=0.8888888888888888, fixedsize=true, label=""];
t_host [pos="912.0,494.0", shape=plaintext, width=3.0555555555555554, height=0.7222222222222222, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="220"><FONT POINT-SIZE="12"><B>Other users of this machine</B></FONT></TD></TR><TR><TD HEIGHT="3"></TD></TR><TR><TD ALIGN="LEFT" WIDTH="220">Not trusted: tools/deploy refuses to run</TD></TR><TR><TD ALIGN="LEFT" WIDTH="220">while etc/ or accounts.yaml is open to them.</TD></TR></TABLE>>];
o_host_a [pos="790,498.0", shape=point, width=0.01, style=invis];
o_host_b [pos="700,498.0", shape=point, width=0.01, style=invis];
o_host_a -> o_host_b [arrowhead=tee, color="#8c8d87"];
o_internet [pos="910.0,340.0", shape=box, style=filled, fillcolor="#f5f5f3", color="#8c8d87", penwidth=1.2, width=3.3333333333333335, height=1.0694444444444444, fixedsize=true, label=""];
t_internet [pos="912.0,336.0", shape=plaintext, width=3.0555555555555554, height=0.9027777777777778, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="220"><FONT POINT-SIZE="12"><B>The Internet</B></FONT></TD></TR><TR><TD HEIGHT="3"></TD></TR><TR><TD ALIGN="LEFT" WIDTH="220">Not trusted by default. From outside, only</TD></TR><TR><TD ALIGN="LEFT" WIDTH="220">through a TLS reverse proxy, with the stack</TD></TR><TR><TD ALIGN="LEFT" WIDTH="220">bound to 127.0.0.1.</TD></TR></TABLE>>];
o_internet_a [pos="790,340.0", shape=point, width=0.01, style=invis];
o_internet_b [pos="700,340.0", shape=point, width=0.01, style=invis];
o_internet_a -> o_internet_b [arrowhead=tee, color="#8c8d87"];
o_path [pos="910.0,182.0", shape=box, style=filled, fillcolor="#f5f5f3", color="#8c8d87", penwidth=1.2, width=3.3333333333333335, height=0.8888888888888888, fixedsize=true, label=""];
t_path [pos="912.0,178.0", shape=plaintext, width=3.0555555555555554, height=0.7222222222222222, fixedsize=true, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="220"><FONT POINT-SIZE="12"><B>The way to your providers</B></FONT></TD></TR><TR><TD HEIGHT="3"></TD></TR><TR><TD ALIGN="LEFT" WIDTH="220">Not trusted. Certificates are verified</TD></TR><TR><TD ALIGN="LEFT" WIDTH="220">for fetching and for sending.</TD></TR></TABLE>>];
o_path_a [pos="790,182.0", shape=point, width=0.01, style=invis];
o_path_b [pos="700,182.0", shape=point, width=0.01, style=invis];
o_path_a -> o_path_b [arrowhead=tee, color="#8c8d87"];
key [pos="525,55", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="24" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP" BALIGN="LEFT"><FONT POINT-SIZE="12"><B>Key</B></FONT><BR ALIGN="LEFT"/>Blue frame · a circle of trust; the deeper, the more it is trusted<BR ALIGN="LEFT"/>Grey box · not trusted<BR ALIGN="LEFT"/>Line ending in a bar · kept out, and how<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP" BALIGN="LEFT"><FONT POINT-SIZE="12"><B>Why</B></FONT><BR ALIGN="LEFT"/>For a family or a small office, a trusted administrator is how things are.<BR ALIGN="LEFT"/>Designing against them (end-to-end encryption, split secrets) would add<BR ALIGN="LEFT"/>complexity this setting does not need, and would still not stop root.<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
