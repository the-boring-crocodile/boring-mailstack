digraph "The containers" {
graph [rankdir=TB, newrank=true, remincross=false, splines=line, nodesep=1.0, ranksep=1.0, bgcolor="#ffffff", pad=0.444, fontname="Helvetica", fontsize=10, labelloc=t, labeljust=l,
label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>The containers</B></FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR><TR><TD ALIGN="LEFT">Container diagram · boring-mailstack · what runs, and how the pieces talk · as of v2026.10.14</TD></TR><TR><TD HEIGHT="10"></TD></TR></TABLE>>];
node [shape=box,style=filled,width=4.42,height=1.4,fontname="Helvetica",fontsize=10,margin="0.167,0.111",fontcolor="#111111",penwidth=1.2];
edge [arrowsize=0.7,penwidth=1.4,color="#587b96"];
imap [fillcolor="#f5f5f3",color="#8c8d87",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Provider mailboxes</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[External mail service · IMAPS]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Provider receives Internet mail</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Retrieved mail stays at the provider</TD></TR></TABLE>>];
contacts [fillcolor="#f5f5f3",color="#8c8d87",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>The user's Nextcloud</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[External service · CardDAV, CalDAV, WebDAV]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Contacts, calendar and files per user</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Each user adds their own; no shared presets</TD></TR></TABLE>>];
smtp [fillcolor="#f5f5f3",color="#8c8d87",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Provider submission</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[External mail service · SMTPS]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Accepts authenticated outbound mail</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Provider owns Internet delivery / DKIM</TD></TR></TABLE>>];
subgraph cluster_mailstack {
label="boring-mailstack · one host, Docker Compose · no MX of its own"; labelloc=b; labeljust=l; color="#929a96"; margin=28;
getmail [fillcolor="#edf5ef",color="#7a9783",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>getmail</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[Container · getmail6 + supervisor]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Fetches by folder role; never deletes mail</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Persistent processing state prevents repeats</TD></TR></TABLE>>];
webmail [fillcolor="#edf2fa",color="#7489a5",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Roundcube</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[Container · webmail, own network]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Mail, Filters, Contacts, Calendar, cloud files</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Reaches Stalwart only inside the stack</TD></TR></TABLE>>];
relay [fillcolor="#edf5ef",color="#7a9783",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>relay</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[Container · Postfix]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Sender-specific provider routing and login</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Allowed senders only; persistent spool</TD></TR></TABLE>>];
bridge [fillcolor="#edf5ef",color="#7a9783",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>bridge</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[Container · Python, Message-ID index]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">INBOX (Junk if listed): SMTP, the user's filter</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Other folders: JMAP import, recorded as placed</TD></TR></TABLE>>];
store [fillcolor="#edf5ef",color="#7a9783",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Stalwart</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[Container · canonical local mail store]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Mailboxes, flags, full-text search and Sieve</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Client submission goes through Postfix</TD></TR></TABLE>>];
provenance [fillcolor="#edf5ef",color="#7a9783",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>provenance</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[Container · Python / SQLite]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Protects provider folders and human moves</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Stable account + JMAP Email ID, not UID</TD></TR></TABLE>>];
resievewatch [fillcolor="#edf5ef",color="#7a9783",label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="0"><TR><TD WIDTH="270" ALIGN="LEFT"><FONT POINT-SIZE="12"><B>resieve-watch</B></FONT></TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">[Container · Python watcher + resieve (Rust)]</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Filter changed: existing mail sorted again</TD></TR><TR><TD WIDTH="270" ALIGN="LEFT">Moved into INBOX: back to the filter</TD></TR></TABLE>>];
{rank=same;getmail;webmail;relay;}
{rank=same;bridge;store;}
{rank=same;provenance;resievewatch;}
getmail -> webmail -> relay [style=invis,weight=100,minlen=2];
}
{rank=same;imap;contacts;smtp;}
imap -> contacts -> smtp [style=invis,weight=100,minlen=2];
// Layout constraints point down; dir=back preserves actual caller direction.
imap -> getmail [dir=back,weight=100];
contacts -> webmail [dir=back,color="#578478",weight=100];
smtp -> relay [dir=back,weight=100];
getmail -> bridge [color="#7b7e85",style=dotted,penwidth=2,weight=100];
webmail -> store [weight=100];
bridge -> store [color="#9b784b",style=dotted,penwidth=2,weight=100,minlen=2];
store -> relay [color="#9b784b",constraint=false];
bridge -> provenance [color="#578478",style=dashed,minlen=2];
store -> provenance [color="#578478",style=dashed,minlen=2,weight=10000];
store -> resievewatch [color="#578478",style=dashed,minlen=2];
provenance -> resievewatch [color="#578478",style=dashed,constraint=false];
resievewatch -> store [color="#9b784b",style=dotted,penwidth=2,constraint=false];
legend [shape=plain,style="",fillcolor="#ffffff",label=<<TABLE BORDER="0" CELLSPACING="24" CELLPADDING="0"><TR><TD VALIGN="TOP"><TABLE BORDER="0" CELLSPACING="8" CELLPADDING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Components and boundaries</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#526c91"><B>Blue</B> · user-facing mail client</FONT><BR ALIGN="LEFT"/><FONT COLOR="#57765f"><B>Sage</B> · local mail services</FONT><BR ALIGN="LEFT"/>Neutral · external services<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">Frame · application ownership, not one network.<BR ALIGN="LEFT"/>Postfix has a separate private relay path.<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">Arrowheads point from caller to service.<BR ALIGN="LEFT"/>getmail polls the provider; mail returns to it.<BR ALIGN="LEFT"/>Local edits never synchronize back upstream.<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><B>Provenance:</B> bridge records non-INBOX imports;<BR ALIGN="LEFT"/>Stalwart reports IMAP moves, copies and appends<BR ALIGN="LEFT"/>by webhook; moves into INBOX go to resieve-watch.<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="0" CELLSPACING="8" CELLPADDING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Protocols</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#587b96"><B>Solid blue · IMAPS / SMTPS</B></FONT><BR ALIGN="LEFT"/>Retrieve, read or submit mail over TLS<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#578478"><B>Solid green · HTTPS / CardDAV</B></FONT><BR ALIGN="LEFT"/>Per-user addressbook access<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7b7e85"><B>Dotted grey · private TCP handoff</B></FONT><BR ALIGN="LEFT"/>Account + provider folder + raw message<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9b784b"><B>Dotted ochre · SMTP / JMAP</B></FONT><BR ALIGN="LEFT"/>Bridge chooses delivery or folder import<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9b784b"><B>Solid ochre · private SMTP</B></FONT><BR ALIGN="LEFT"/>Stalwart submits to the Postfix relay<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#578478"><B>Dashed green · private HTTP</B></FONT><BR ALIGN="LEFT"/>Placement protection / move events<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="0" CELLSPACING="8" CELLPADDING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Operations and scope</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>Setup:</B> accounts.yaml and folders.yaml.<BR ALIGN="LEFT"/>Prepare / init generate configuration and reconcile<BR ALIGN="LEFT"/>Stalwart; generated files are reconstructible.<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><B>Keep:</B> Stalwart mail/config, getmail state,<BR ALIGN="LEFT"/>provenance DB, relay spool and Roundcube DB.<BR ALIGN="LEFT"/>Inbound delivery is at least once.<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><B>resieve</B> evaluates the active filter, honors<BR ALIGN="LEFT"/>placements by hand and changes folders by JMAP.<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">Setup, browser ingress, other clients, ManageSieve<BR ALIGN="LEFT"/>and the provider-Junk port (2525) are not drawn.<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
provenance -> legend [style=invis,weight=10000];
}
