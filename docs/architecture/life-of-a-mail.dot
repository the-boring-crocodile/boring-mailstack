digraph "The life of a mail" {
graph [fontname="Helvetica", bgcolor="#ffffff", pad=0.444, splines=line, outputorder=nodesfirst];
node [fontname="Helvetica", fontsize=10, fontcolor="#111111"];
edge [arrowsize=0.7, penwidth=1.4];
title [pos="205,548", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="400"><FONT POINT-SIZE="18"><B>The life of a mail</B></FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR><TR><TD ALIGN="LEFT">Dynamic diagram · boring-mailstack · what you file, the filter leaves alone</TD></TR></TABLE>>];
lane_Inbox [pos="475,400", shape=box, style="filled,rounded", fillcolor="#f4f5f3", color="#dfe2df", width=12.64, height=0.694, fixedsize=true, label=""];
lanelabel_Inbox [pos="72,400", shape=plaintext, label=<<TABLE BORDER="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="90"><B>Inbox</B></TD></TR></TABLE>>];
lane_News [pos="475,335", shape=box, style="filled,rounded", fillcolor="#f4f5f3", color="#dfe2df", width=12.64, height=0.694, fixedsize=true, label=""];
lanelabel_News [pos="72,335", shape=plaintext, label=<<TABLE BORDER="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="90"><B>News</B></TD></TR></TABLE>>];
lane_Reading [pos="475,270", shape=box, style="filled,rounded", fillcolor="#f4f5f3", color="#dfe2df", width=12.64, height=0.694, fixedsize=true, label=""];
lanelabel_Reading [pos="72,270", shape=plaintext, label=<<TABLE BORDER="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="90"><B>Reading</B></TD></TR></TABLE>>];
lane_Keep [pos="475,205", shape=box, style="filled,rounded", fillcolor="#f4f5f3", color="#dfe2df", width=12.64, height=0.694, fixedsize=true, label=""];
lanelabel_Keep [pos="72,205", shape=plaintext, label=<<TABLE BORDER="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="90"><B>Keep</B></TD></TR></TABLE>>];
num1 [pos="146,488", shape=circle, width=0.21, height=0.21, fixedsize=true, style=filled, fillcolor="#ffffff", color="#587b96", penwidth=1.2, fontsize=10, fontcolor="#33506a", label=<<B>1</B>>];
head1 [pos="240,472", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="1" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="168"><B>Mail arrives</B></TD></TR><TR><TD ALIGN="LEFT">Your filter: newsletters &#8594; News.</TD></TR><TR><TD ALIGN="LEFT">It files A and B.</TD></TR></TABLE>>];
num2 [pos="346,488", shape=circle, width=0.21, height=0.21, fixedsize=true, style=filled, fillcolor="#ffffff", color="#587b96", penwidth=1.2, fontsize=10, fontcolor="#33506a", label=<<B>2</B>>];
head2 [pos="440,472", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="1" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="168"><B>You file B into Keep</B></TD></TR><TR><TD ALIGN="LEFT">Recorded: placed by you.</TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
num3 [pos="546,488", shape=circle, width=0.21, height=0.21, fixedsize=true, style=filled, fillcolor="#ffffff", color="#587b96", penwidth=1.2, fontsize=10, fontcolor="#33506a", label=<<B>3</B>>];
head3 [pos="640,472", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="1" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="168"><B>You change the filter</B></TD></TR><TR><TD ALIGN="LEFT">newsletters &#8594; Reading. A minute</TD></TR><TR><TD ALIGN="LEFT">later the filter re-sorts.</TD></TR></TABLE>>];
num4 [pos="746,488", shape=circle, width=0.21, height=0.21, fixedsize=true, style=filled, fillcolor="#ffffff", color="#587b96", penwidth=1.2, fontsize=10, fontcolor="#33506a", label=<<B>4</B>>];
head4 [pos="840,472", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="1" CELLPADDING="0"><TR><TD ALIGN="LEFT" WIDTH="168"><B>You move B to the Inbox</B></TD></TR><TR><TD ALIGN="LEFT">Released: the filter</TD></TR><TR><TD ALIGN="LEFT">files it again.</TD></TR></TABLE>>];
new [pos="150,400", shape=point, width=0.08, color="#578478"];
B1 [pos="205,335", shape=box, style="filled,rounded", fillcolor="#ffffff", color="#7a8a96", penwidth=1.0, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>B</B>>];
A1 [pos="255,335", shape=box, style="filled,rounded", fillcolor="#ffffff", color="#7a8a96", penwidth=1.0, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>A</B>>];
A2 [pos="430,335", shape=box, style="filled,rounded", fillcolor="#ffffff", color="#7a8a96", penwidth=1.0, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>A</B>>];
B2 [pos="430,205", shape=box, style="filled,rounded", fillcolor="#edf2fa", color="#33506a", penwidth=2.6, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>B</B>>];
A3 [pos="630,270", shape=box, style="filled,rounded", fillcolor="#ffffff", color="#7a8a96", penwidth=1.0, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>A</B>>];
B3 [pos="630,205", shape=box, style="filled,rounded", fillcolor="#edf2fa", color="#33506a", penwidth=2.6, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>B</B>>];
A4 [pos="790,270", shape=box, style="filled,rounded", fillcolor="#ffffff", color="#7a8a96", penwidth=1.0, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>A</B>>];
B4i [pos="870,400", shape=box, style="filled,rounded", fillcolor="#ffffff", color="#7a8a96", penwidth=1.0, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>B</B>>];
B4 [pos="870,270", shape=box, style="filled,rounded", fillcolor="#ffffff", color="#7a8a96", penwidth=1.0, width=0.5, height=0.32, fixedsize=true, fontsize=11, label=<<B>B</B>>];
new -> A1 [color="#578478"];
new -> B1 [color="#578478"];
A1 -> A2 [color="#b3b8b5", style=dotted, dir=none, penwidth=1.2];
B1 -> B2 [color="#587b96"];
A2 -> A3 [color="#578478"];
B2 -> B3 [color="#b3b8b5", style=dotted, dir=none, penwidth=1.2];
A3 -> A4 [color="#b3b8b5", style=dotted, dir=none, penwidth=1.2];
B3 -> B4i [color="#587b96"];
B4i -> B4 [color="#578478"];
key [pos="500,92", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="24" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP" BALIGN="LEFT"><FONT POINT-SIZE="12"><B>Key</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#587b96"><B>Blue arrow</B></FONT> · you move the mail<BR ALIGN="LEFT"/><FONT COLOR="#578478"><B>Green arrow</B></FONT> · your filter moves it<BR ALIGN="LEFT"/>Dotted line · it stays where it is<BR ALIGN="LEFT"/><B>Bold frame</B> · placed by you: the filter leaves it alone<BR ALIGN="LEFT"/>Grey band · a folder<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP" BALIGN="LEFT"><FONT POINT-SIZE="12"><B>The rule</B></FONT><BR ALIGN="LEFT"/>Where you put a mail, it stays: a move or copy in the webmail<BR ALIGN="LEFT"/>or any IMAP client, and a folder you had filed it into at<BR ALIGN="LEFT"/>your provider. Everything else goes where your filter says,<BR ALIGN="LEFT"/>also when you change the filter. Moving a mail into the Inbox<BR ALIGN="LEFT"/>hands it back to the filter.<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
