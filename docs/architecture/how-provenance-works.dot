key [pos="515,70", shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="24" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP" BALIGN="LEFT"><FONT POINT-SIZE="12"><B>Key</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="#587b96"><B>Blue arrow</B></FONT> · started by you<BR ALIGN="LEFT"/><FONT COLOR="#578478"><B>Green arrow</B></FONT> · the stack on its own<BR ALIGN="LEFT"/><FONT COLOR="#578478"><B>Dashed green</B></FONT> · a record read or written<BR ALIGN="LEFT"/><I>Grey italics</I> · what happens inside<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP" BALIGN="LEFT"><FONT POINT-SIZE="12"><B>Notes</B></FONT><BR ALIGN="LEFT"/>The records are one SQLite file: provenance writes it,<BR ALIGN="LEFT"/>resieve reads it and removes released records.<BR ALIGN="LEFT"/>A mail you had filed at your provider is recorded when<BR ALIGN="LEFT"/>the bridge imports it (not drawn).<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
