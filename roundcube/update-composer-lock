#!/bin/sh
# Change the Roundcube image's PHP libraries or Composer-installed plugins:
# runs Composer in the release's own Roundcube base image on
# roundcube/composer.json and composer.lock, and writes both back.
#
#   roundcube/update-composer-lock require -W nicofrand/roundav:3.0.2
#   roundcube/update-composer-lock update -W sabre/vobject
#   roundcube/update-composer-lock update          # everything within the constraints
#
# Then: build, run the acceptance test (tests/demo/run.sh), commit both files.
# After a new base image (Dockerfile ARG ROUNDCUBE_IMAGE), start from that image's own
# composer.json/lock and re-add ours: see roundcube/README.md.
set -eu
dir=$(cd "$(dirname "$0")" && pwd)
base=$(sed -n 's/^ARG ROUNDCUBE_IMAGE=\(.*\)$/\1/p' "$dir/Dockerfile")
[ -n "$base" ] || { echo "update-composer-lock: no Roundcube base image in the Dockerfile" >&2; exit 1; }
[ $# -gt 0 ] || { sed -n '2,13s/^# \{0,1\}//p' "$0"; exit 2; }
docker run --rm -v "$dir:/out" --entrypoint sh "$base" -c '
    set -e
    cd /usr/src/roundcubemail
    cp /out/composer.json /out/composer.lock .
    COMPOSER_ALLOW_SUPERUSER=1 composer --no-interaction "$@"
    composer validate --no-check-publish --no-check-all -q
    cp composer.json composer.lock /out/
' update-composer-lock "$@"
git -C "$dir" diff --stat -- composer.json composer.lock
